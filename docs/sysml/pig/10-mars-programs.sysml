		attribute mask_band : Integer default = 1 { doc /* Band to use for mask input */ }
		attribute mask_thresh : Real default = 5.0 { doc /* Goodness threshold for mask input */ }
		attribute good_value : Integer default = 5 { doc /* Output value for good status */ }
		attribute single_bad : Integer[1..5] ordered nonunique default = (2, 2, 3, 3, 4) { doc /* Output value for a single input being bad */ }
		attribute multi_bad : Integer default = 1 { doc /* Output value for multiple inputs being bad */ }
		attribute mask_bad : Integer default = 0 { doc /* Output value for mask input being bad */ }
		attribute point_method : String[0..1] { doc /* Specifies a mission- specific pointing method to use */ }
		attribute data_set_name : String[0..1] { doc /* Specifies the full name given to a data set or a data product */ }
		attribute data_set_id : String[0..1] { doc /* Specifies a unique alphanumeric identifier for a data set or data product */ }
		attribute release_id : String[0..1] { doc /* Specifies the unique identifier associated with the release to the public of all or part of a data set */ }
		attribute product_id : String[0..1] { doc /* Specifies a permanent, unique identifier assigned to a data product by its producer */ }
		attribute producer_id : String[0..1] { doc /* Specifies the unique identifier of an entity associated with the production a data set */ }
		attribute producer_inst : String[0..1] { doc /* Specifies the full name of the identity of an entity associated with the production of a data set */ }
		attribute target_name : String[0..1] { doc /* Specifies a target */ }
		attribute target_type : String[0..1] { doc /* Specifies the type of a named target */ }
	}
	item def MarsigoodSetupFiles :> MarsSetupFiles {
		ref item config_path : MarsConfigTree { doc /* CONFIG_PATH: Path used to find configuration/calibration files */ }
	}
	action def marsigood {
		doc /* VICAR program MARSIGOOD */
		in item inp : MarsProduct[1..5] ordered { doc /* INP: Input files */ }
		out item 'out' : GoodnessImage { doc /* OUT: Output file */ }
		in item mask : VicarImage[0..1] { doc /* MASK: Optional input mask file */ }
		in item setup : MarsigoodSetupFiles;
		in attribute params : MarsigoodParams;
	}

	// marsgreach: 5 file parameters, 17 other parameters
	enum def MarsgreachBestConf { enum 'BEST_CONF'; }
	enum def MarsgreachNosite { enum 'NOSITE'; }
	enum def MarsgreachDebugRsf { enum 'DEBUG_RSF'; }
	enum def MarsgreachCoord { enum 'FIXED'; enum 'INSTRUMENT'; enum 'SITE'; enum 'ROVER'; enum 'LOCAL_LEVEL'; enum 'RMECH'; }
	attribute def MarsgreachParams {
		doc /* Non-file parameters of marsgreach.pdf. */
		attribute bands : Integer[1..6] ordered nonunique default = (1, 2, 3, 4, 5, 6) { doc /* Selected band numbers from the input file */ }
		attribute best_conf : MarsgreachBestConf[0..1] { doc /* Set this keyword to produce the second output band */ }
		attribute point_method : String[0..1] { doc /* Specifies a mission- specific pointing method to use */ }
		attribute nosite : MarsgreachNosite[0..1] { doc /* Disables coordinate system sites */ }
		attribute data_set_name : String[0..1] { doc /* Specifies the full name given to a data set or a data product */ }
		attribute data_set_id : String[0..1] { doc /* Specifies a unique alphanumeric identifier for a data set or data product */ }
		attribute release_id : String[0..1] { doc /* Specifies the unique identifier associated with the release to the public of all or part of a data set */ }
		attribute product_id : String[0..1] { doc /* Specifies a permanent, unique identifier assigned to a data product by its producer */ }
		attribute producer_id : String[0..1] { doc /* Specifies the unique identifier of an entity associated with the production a data set */ }
		attribute producer_inst : String[0..1] { doc /* Specifies the full name of the identity of an entity associated with the production of a data set */ }
		attribute target_name : String[0..1] { doc /* Specifies a target */ }
		attribute target_type : String[0..1] { doc /* Specifies the type of a named target */ }
		attribute debug_rsf : MarsgreachDebugRsf[0..1] { doc /* Turns on debugging of RSF parameter */ }
		attribute coord : MarsgreachCoord default = MarsgreachCoord::'RMECH' { doc /* Coordinate system to use */ }
		attribute coord_index : Integer[0..10] ordered nonunique { doc /* Coordinate system index for some COORD/mission combos */ }
		attribute fixed_site : Integer[0..1] { doc /* Which site is FIXED for rover missions */ }
		attribute solution_id : String[0..1] { doc /* Solution ID to use for COORD_INDEX */ }
	}
	item def MarsgreachSetupFiles :> MarsSetupFiles {
		ref item config_path : MarsConfigTree { doc /* CONFIG_PATH: Path used to find configuration/calibration files */ }
		ref item rsf : RoverStateFile[0..100] ordered { doc /* RSF: Rover State File(s) to use */ }
	}
	action def marsgreach {
		doc /* VICAR program MARSGREACH. */
		in item inp : ReachabilityImage[1..3] ordered { doc /* INP: Input reachability file */ }
		out item 'out' : GoodnessImage { doc /* OUT: Output file */ }
		in item navtable : NavFile[0..1] { doc /* NAVTABLE: Corrected navigation filename */ }
		in item setup : MarsgreachSetupFiles;
		in attribute params : MarsgreachParams;
	}
}
