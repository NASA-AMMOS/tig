/*
 * Inputs, outputs and parameters of the VISOR programs that the TIG demos run.
 * GENERATED by tools/gen-programs.py from vos/mars/src/prog/<program>/<program>.pdf;
 * do not edit by hand. Each program is an action def: file parameters are typed in/out
 * items (direction from the PDF help), every other PARM is an attribute of <Program>Params.
 */
package MarsPrograms {
	private import ScalarValues::*;
	private import PigData::Files::*;
	private import PigData::Products::*;
	private import PigData::Calibration::*;

	abstract item def MarsSetupFiles {
		doc /* Calibration tree, rover-state and surface files a program passes to mars_setup. */
	}

